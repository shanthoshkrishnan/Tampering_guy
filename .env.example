# ===================================
# TamperGuard Environment Variables
# ===================================
# 
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
#
# Usage: cp .env.example .env
#

# ===================================
# Firebase Configuration
# ===================================
# Get these from Firebase Console > Project Settings > General > Your apps > Web app
# https://console.firebase.google.com/

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdefghijklmnop

# Optional: Firebase measurement ID for Google Analytics
# VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ===================================
# MQTT Broker Configuration
# ===================================
# Default: HiveMQ public broker (for development only)
# Production: Use authenticated broker with WSS

VITE_MQTT_BROKER_URL=wss://broker.hivemq.com:8884/mqtt
VITE_MQTT_TOPIC_DATA=tamper/esp32/data
VITE_MQTT_TOPIC_CMD=tamper/esp32/cmd

# Optional: MQTT authentication (if using private broker)
# VITE_MQTT_USERNAME=your_mqtt_username
# VITE_MQTT_PASSWORD=your_mqtt_password

# ===================================
# Application Configuration
# ===================================

# Environment: development, staging, production
VITE_APP_ENV=development

# Base URL for API calls (if using external API)
# VITE_API_BASE_URL=https://api.tamperguard.com

# Application version (auto-updated by CI/CD)
VITE_APP_VERSION=1.0.0

# ===================================
# Email Service Configuration
# ===================================
# EmailJS - for sending verification emails
# Get credentials from: https://www.emailjs.com/

VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# ===================================
# SMS/Notification Services (Optional)
# ===================================
# Twilio - for SMS alerts
# VITE_TWILIO_ACCOUNT_SID=your_twilio_account_sid
# VITE_TWILIO_AUTH_TOKEN=your_twilio_auth_token
# VITE_TWILIO_PHONE_NUMBER=+1234567890

# ===================================
# Map Services (Optional)
# ===================================
# Mapbox or Google Maps API key (if using premium map features)
# VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_token
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key

# ===================================
# Analytics & Monitoring (Optional)
# ===================================
# Google Analytics
# VITE_GA_TRACKING_ID=UA-XXXXXXXXX-X

# Sentry for error tracking
# VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ===================================
# Feature Flags
# ===================================
# Enable/disable features for different environments

VITE_FEATURE_BLOCKCHAIN_DASHBOARD=true
VITE_FEATURE_DEVICE_AUTO_LOCK=true
VITE_FEATURE_PWA_ENABLED=true
VITE_FEATURE_DARK_MODE=true

# ===================================
# Development Settings
# ===================================
# Only used in development mode

# Enable debug logging
VITE_DEBUG_MODE=false

# Mock data instead of real MQTT (useful for testing UI)
VITE_USE_MOCK_DATA=false

# Bypass email verification (NEVER in production!)
# VITE_SKIP_EMAIL_VERIFICATION=false

# ===================================
# Security Settings
# ===================================

# Session timeout in milliseconds (default: 1 hour)
VITE_SESSION_TIMEOUT=3600000

# Maximum failed login attempts before lockout
VITE_MAX_LOGIN_ATTEMPTS=5

# Password minimum length
VITE_PASSWORD_MIN_LENGTH=8

# ===================================
# Firebase Admin SDK (Server-side only)
# ===================================
# These should be set as environment variables on your server
# NEVER include these in client-side .env!
#
# FIREBASE_ADMIN_PROJECT_ID=your-project-id
# FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"

# ===================================
# Notes
# ===================================
#
# 1. All VITE_ prefixed variables are exposed to the client
# 2. Never commit sensitive credentials to version control
# 3. Use Firebase Hosting environment configs for production
# 4. Rotate credentials regularly (every 90 days recommended)
# 5. Use different Firebase projects for dev/staging/production
# 6. Keep this .env.example file updated when adding new variables
#
